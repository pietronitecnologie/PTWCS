   "props": {
    "symbol": "div_pusher"
   },
   "bindings": {
    "elements.load.visible": {
     "kind": "tag",
     "tag": "{device}.Occupied"
    },
    "elements.body.fill": {
     "kind": "expr",
     "expr": "tag('{device}.Fault') ? '#ef4444' : tag('{device}.Position') > 0 ? '#f59e0b' : '#64748b'"
    },
    "elements.flow.flow": {
     "kind": "tag",
     "tag": "{device}.Run"
    },
    "elements.flow.visible": {
     "kind": "tag",
     "tag": "{device}.Run"
    },
    "elements.pusher.ty": {
     "kind": "tag",
     "tag": "{device}.Position",
     "transform": {
      "kind": "map",
      "rules": [
       {
        "in": ">0",
        "out": "42"
       }
      ],
      "default": "0"
     }
    }
   },
   "events": {}
  },
