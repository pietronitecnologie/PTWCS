   "props": {
    "text": "AGV / AMR · UDT Veicolo",
    "fontSize": 12,
    "color": "#8b9bb8"
   },
   "bindings": {},
   "events": {}
  },
  {
   "id": "preview",
   "type": "symbol",
   "name": "preview",
   "x": 300,
   "y": 31,
   "w": 140,
   "h": 96,
   "rotation": 0,
   "props": {
    "symbol": "veh_agv"
   },
   "bindings": {
    "elements.label.text": {
     "kind": "expr",
     "expr": "param('device') || ''"
    },
    "elements.fault.visible": {
     "kind": "tag",
     "tag": "{device}.Fault"
    },
    "elements.load.visible": {
     "kind": "tag",
     "tag": "{device}.Loaded"
    },
    "elements.body.fill": {
     "kind": "expr",
     "expr": "tag('{device}.Fault') ? '#ef4444' : tag('{device}.Charging') ? '#38bdf8' : tag('{device}.Moving') ? '#22c55e' : '#64748b'"
    },
    "elements.lidar.blink": {
     "kind": "tag",
     "tag": "{device}.Moving"
    },
    "elements.led.fill": {
     "kind": "tag",
     "tag": "{device}.State",
     "transform": {
      "kind": "map",
      "rules": [
       {
        "in": "0",
        "out": "#334155"
       },
       {
        "in": "1",
        "out": "#22c55e"
       },
       {
        "in": "2",
        "out": "#f59e0b"
       }
      ],
      "default": "#ef4444"
     }
    },
    "elements.battery.fill": {
     "kind": "tag",
     "tag": "{device}.Battery",
     "transform": {
      "kind": "map",
      "rules": [
       {
        "in": "<20",
        "out": "#ef4444"
       },
       {
        "in": "<50",
        "out": "#f59e0b"
       }
      ],
      "default": "#22c55e"
     }
    }
   },
   "events": {}
  },
