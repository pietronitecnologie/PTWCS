   },
   "bindings": {
    "text": {
     "kind": "expr",
     "expr": "param('device') || '(nessun dispositivo)'"
    }
   },
   "events": {}
  },
  {
   "id": "subtitle",
   "type": "label",
   "name": "subtitle",
