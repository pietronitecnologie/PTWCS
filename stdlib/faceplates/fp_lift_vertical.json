   },
   "bindings": {},
   "events": {}
  },
  {
   "id": "preview",
   "type": "symbol",
   "name": "preview",
   "x": 357,
   "y": 24,
   "w": 83,
   "h": 110,
   "rotation": 0,
   "props": {
    "symbol": "lift_vertical"
   },
   "bindings": {
    "elements.label.text": {
     "kind": "expr",
     "expr": "param('device') || ''"
    },
    "elements.fault.visible": {
     "kind": "tag",
     "tag": "{device}.Fault"
    },
    "elements.load.visible": {
     "kind": "tag",
     "tag": "{device}.Occupied"
    },
    "elements.body.fill": {
     "kind": "expr",
     "expr": "tag('{device}.Fault') ? '#ef4444' : tag('{device}.Moving') ? '#f59e0b' : '#64748b'"
    },
    "elements.carriage.ty": {
     "kind": "expr",
     "expr": "-(tag('{device}.PosPct') || 0) * 1.2"
    },
    "elements.drive.fill": {
     "kind": "tag",
     "tag": "{device}.Moving",
     "transform": {
      "kind": "map",
      "rules": [
       {
        "in": "true",
        "out": "#22c55e"
       }
      ],
      "default": "#334155"
     }
    }
   },
   "events": {}
  },
