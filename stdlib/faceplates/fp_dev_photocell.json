{
 "title": "Faceplate – Fotocellula",
 "width": 460,
 "height": 340,
 "background": "#0b1220",
 "home": false,
 "faceplate": true,
 "params": {
  "device": ""
 },
 "components": [
  {
   "id": "bg",
   "type": "rect",
   "name": "bg",
   "x": 0,
   "y": 0,
   "w": 460,
   "h": 340,
   "rotation": 0,
   "props": {
    "fill": "#111a2e",
    "stroke": "#24324f",
    "radius": 10
   },
   "bindings": {},
   "events": {}
  },
  {
   "id": "title",
   "type": "label",
   "name": "title",
   "x": 20,
   "y": 14,
   "w": 300,
   "h": 30,
   "rotation": 0,
   "props": {
    "text": "",
    "fontSize": 20,
    "bold": true
   },
   "bindings": {
    "text": {
     "kind": "expr",
     "expr": "param('device') || '(nessun dispositivo)'"
    }
   },
   "events": {}
  },
  {
   "id": "subtitle",
   "type": "label",
   "name": "subtitle",
   "x": 20,
   "y": 42,
   "w": 300,
   "h": 20,
   "rotation": 0,
   "props": {
    "text": "Fotocellula · UDT Sensore",
    "fontSize": 12,
    "color": "#8b9bb8"
   },
   "bindings": {},
   "events": {}
  },
  {
   "id": "preview",
   "type": "symbol",
   "name": "preview",
   "x": 300,
   "y": 44,
   "w": 140,
   "h": 70,
   "rotation": 0,
   "props": {
    "symbol": "dev_photocell"
   },
   "bindings": {
    "elements.label.text": {
     "kind": "expr",
     "expr": "param('device') || ''"
    },
    "elements.fault.visible": {
     "kind": "tag",
     "tag": "{device}.Fault"
    },
    "elements.beam.stroke": {
     "kind": "tag",
     "tag": "{device}.Blocked",
     "transform": {
      "kind": "map",
      "rules": [
       {
        "in": "true",
        "out": "#f59e0b"
       }
      ],
      "default": "#22c55e"
     }
    },
    "elements.led.fill": {
     "kind": "tag",
     "tag": "{device}.Blocked",
     "transform": {
      "kind": "map",
      "rules": [
       {
        "in": "true",
        "out": "#f59e0b"
       }
      ],
      "default": "#334155"
     }
    },
    "elements.body.fill": {
     "kind": "expr",
     "expr": "tag('{device}.Fault') ? '#ef4444' : tag('{device}.Dirty') ? '#f59e0b' : '#64748b'"
    }
   },
   "events": {}
  },
  {
   "id": "h_state",
   "type": "label",
   "name": "h_state",
   "x": 20,
   "y": 150,
   "w": 200,
   "h": 20,
   "rotation": 0,
   "props": {
    "text": "STATO",
    "fontSize": 11,
    "color": "#8b9bb8",
    "bold": true
   },
   "bindings": {},
   "events": {}
  },
  {
   "id": "st_Blocked",
   "type": "lamp",
   "name": "st_Blocked",
   "x": 20,
   "y": 176,
   "w": 20,
   "h": 20,
   "rotation": 0,
   "props": {
    "label": "Interrotta",
    "colorOn": "#f59e0b"
   },
   "bindings": {
    "on": {
     "kind": "tag",
     "tag": "{device}.Blocked"
    }
   },
   "events": {}
  },
  {
   "id": "st_Fault",
   "type": "lamp",
   "name": "st_Fault",
   "x": 235,
   "y": 176,
   "w": 20,
   "h": 20,
   "rotation": 0,
   "props": {
    "label": "Guasto",
    "colorOn": "#ef4444"
   },
   "bindings": {
    "on": {
     "kind": "tag",
     "tag": "{device}.Fault"
    }
   },
   "events": {}
  },
  {
   "id": "st_Dirty",
   "type": "lamp",
   "name": "st_Dirty",
   "x": 20,
   "y": 204,
   "w": 20,
   "h": 20,
   "rotation": 0,
   "props": {
    "label": "Sporca",
    "colorOn": "#f59e0b"
   },
   "bindings": {
    "on": {
     "kind": "tag",
     "tag": "{device}.Dirty"
    }
   },
   "events": {}
  },
  {
   "id": "h_val",
   "type": "label",
   "name": "h_val",
   "x": 20,
   "y": 242,
   "w": 200,
   "h": 20,
   "rotation": 0,
   "props": {
    "text": "MISURE",
    "fontSize": 11,
    "color": "#8b9bb8",
    "bold": true
   },
   "bindings": {},
   "events": {}
  },
  {
   "id": "v_Count",
   "type": "value",
   "name": "v_Count",
   "x": 20,
   "y": 282,
   "w": 200,
   "h": 30,
   "rotation": 0,
   "props": {
    "label": "Interruzioni",
    "unit": "",
    "decimals": 0,
    "fontSize": 16
   },
   "bindings": {
    "value": {
     "kind": "tag",
     "tag": "{device}.Count"
    }
   },
   "events": {}
  }
 ]
}