{
  "enabled": true,
  "description": "Smistamento colli allo scanner SC1: WMS, classi di smistamento, eccezioni",
  "rules": [
    { "id": "r1", "name": "Lettura fallita", "when": [ { "field": "barcode", "op": "in", "value": "NOREAD," } ],
      "then": { "outputs": { "destination": "99", "result": "1" }, "log": "NOREAD → scarto" } },
    { "id": "r2", "name": "Sovrappeso", "when": [ { "field": "weight", "op": "gt", "value": "tag:WCS.MaxWeight" } ],
      "then": { "outputs": { "destination": "99", "result": "2" }, "log": "{barcode} sovrappeso ({weight})" } },
    { "id": "r3", "name": "Destinazione forzata dal WMS", "when": [ { "field": "barcode", "op": "wms_known" } ],
      "then": { "outputs": { "destination": "wms:barcode", "result": "0" }, "log": "{barcode}: destinazione dal WMS" } },
    { "id": "r4", "name": "Prioritari (classe WMS)", "when": [ { "field": "barcode", "op": "in_class", "value": "PRIORITARI" } ],
      "then": { "outputs": { "destination": "1", "result": "0" } } },
    { "id": "r5", "name": "Estero con uscita 3 disabilitata → bilancia 1/2",
      "when": [ { "field": "barcode", "op": "in_class", "value": "ESTERO" }, { "field": "tag:WCS.Out3Enabled", "op": "eq", "value": "false" } ],
      "then": { "outputs": { "destination": "1|2", "result": "0" }, "log": "{barcode}: uscita 3 disabilitata, bilanciamento" } },
    { "id": "r6", "name": "Classe di smistamento", "when": [ { "field": "barcode", "op": "has_class" } ],
      "then": { "outputs": { "destination": "class:barcode", "result": "0" } } }
  ],
  "default": { "outputs": { "destination": "99", "result": "3" }, "log": "{barcode}: destinazione sconosciuta" }
}
