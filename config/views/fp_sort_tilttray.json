{
 "title": "Faceplate – Sorter a vassoi basculanti",
 "width": 460,
 "height": 666,
 "background": "#0b1220",
 "home": false,
 "faceplate": true,
 "params": {
  "device": ""
 },
 "components": [
  {
   "id": "bg",
   "type": "rect",
   "name": "bg",
   "x": 0,
   "y": 0,
   "w": 460,
   "h": 666,
   "rotation": 0,
   "props": {
    "fill": "#111a2e",
    "stroke": "#24324f",
    "radius": 10
   },
   "bindings": {},
   "events": {}
  },
  {
   "id": "title",
   "type": "label",
   "name": "title",
   "x": 20,
   "y": 14,
   "w": 300,
   "h": 30,
   "rotation": 0,
   "props": {
    "text": "",
    "fontSize": 20,
    "bold": true
   },
   "bindings": {
    "text": {
     "kind": "expr",
     "expr": "param('device') || '(nessun dispositivo)'"
    }
   },
   "events": {}
  },
  {
   "id": "subtitle",
   "type": "label",
   "name": "subtitle",
   "x": 20,
   "y": 42,
   "w": 300,
   "h": 20,
   "rotation": 0,
   "props": {
    "text": "Sorter a vassoi basculanti · UDT Sorter",
    "fontSize": 12,
    "color": "#8b9bb8"
   },
   "bindings": {},
   "events": {}
  },
  {
   "id": "preview",
   "type": "symbol",
   "name": "preview",
   "x": 300,
   "y": 55,
   "w": 140,
   "h": 48,
   "rotation": 0,
   "props": {
    "symbol": "sort_tilttray"
   },
   "bindings": {
    "elements.label.text": {
     "kind": "expr",
     "expr": "param('device') || ''"
    },
    "elements.fault.visible": {
     "kind": "tag",
     "tag": "{device}.Fault"
    },
    "elements.load.visible": {
     "kind": "tag",
     "tag": "{device}.Occupied"
    },
    "elements.body.fill": {
     "kind": "expr",
     "expr": "tag('{device}.Fault') ? '#ef4444' : tag('{device}.Run') ? '#22c55e' : '#64748b'"
    },
    "elements.carriers.flow": {
     "kind": "tag",
     "tag": "{device}.Run"
    },
    "elements.tray.rotate": {
     "kind": "tag",
     "tag": "{device}.Divert",
     "transform": {
      "kind": "map",
      "rules": [
       {
        "in": "true",
        "out": "25"
       }
      ],
      "default": "0"
     }
    }
   },
   "events": {}
  },
  {
   "id": "h_state",
   "type": "label",
   "name": "h_state",
   "x": 20,
