     "kind": "expr",
     "expr": "(tag('{device}.PctX') || 0) * 2"
    },
    "elements.carriage.ty": {
     "kind": "expr",
     "expr": "-(tag('{device}.PctY') || 0) * 1.4"
    },
    "elements.forks.tx": {
     "kind": "expr",
     "expr": "(tag('{device}.Fork') || 0) * 0.2"
    },
    "elements.forks2.tx": {
     "kind": "expr",
     "expr": "(tag('{device}.Fork2') || 0) * 0.2"
    },
    "elements.load2.visible": {
     "kind": "tag",
     "tag": "{device}.Loaded2"
    },
    "elements.body.fill": {
     "kind": "expr",
     "expr": "tag('{device}.Fault') ? '#ef4444' : tag('{device}.Moving') ? '#22c55e' : '#64748b'"
    }
