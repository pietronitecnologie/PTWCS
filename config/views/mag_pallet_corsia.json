          "kind": "expr"
        },
        "elements.carriage.ty": {
          "expr": "-(tag('{device}.PctY') || 0) / 100 * 172.9",
          "kind": "expr"
        },
        "elements.fault.visible": {
          "kind": "tag",
          "tag": "{device}.Fault"
        },
        "elements.forks.tx": {
          "expr": "(tag('{device}.Fork') || 0) * 0.3",
          "kind": "expr"
        },
        "elements.label.text": {
          "expr": "''",
          "kind": "expr"
        },
        "elements.load.visible": {
          "kind": "tag",
          "tag": "{device}.Loaded"
        },
        "elements.mast.tx": {
          "expr": "(tag('{device}.PctX') || 0) / 100 * 775.1",
          "kind": "expr"
        }
      },
      "custom": {
